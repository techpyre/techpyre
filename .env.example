# SMTP configuration (contact form & outbound)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=replace_with_smtp_password
CONTACT_RECEIVER_EMAIL=info@techpyre.eu

# Admin authentication & encrypted local SMTP storage
# Generate ADMIN_SESSION_SECRET with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace_with_32_byte_random_hex_secret
# JSON array: [{"username":"admin","displayName":"Admin","role":"admin","roleLabel":"Founder & Admin","defaultEmail":"info@techpyre.eu","passwordHash":"scrypt$salt$hash"}]
ADMIN_USERS_JSON=[]
# 64 hex chars (32 bytes) for AES-256-GCM encryption of per-user SMTP passwords
SMTP_STORAGE_KEY=replace_with_64_hex_chars_encryption_key

# Optional integrations
GOOGLE_PAGESPEED_API_KEY=
TECHPYRE_GDRIVE_CRM_ID=
OUTBOUND_FROM_NAME=TechPYRE Studio
